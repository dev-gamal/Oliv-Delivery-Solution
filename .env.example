# ===================================================================
# O'LIV - Variables d'environnement (TEMPLATE)
# Copiez ce fichier en .env et remplissez les valeurs.
# ===================================================================

# --- Base de données MySQL ---
DB_URL=jdbc:mysql://localhost:3306/oliv_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Africa/Casablanca&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# --- JWT Security ---
JWT_SECRET=your_jwt_secret_hex_key
JWT_EXPIRATION_MS=86400000

# --- JWT Test (profil test, H2) ---
JWT_SECRET_TEST=your_test_jwt_secret_hex_key

# --- Server ---
SERVER_PORT=8080
